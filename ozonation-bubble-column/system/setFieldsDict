FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Padrão de todo o domínio: Gás puro (atribui gás para a metade superior Y > 0.5m)
defaultFieldValues
(
    volScalarFieldValue alpha.gas 1
    volScalarFieldValue alpha.liquid 0
);

regions
(
    boxToCell
    {
        // Caixa cobrindo toda a largura/profundidade e a metade inferior do domínio (Y: -0.01m a 0.50m)
        box (-0.08 -0.01 -0.08) (0.08 0.50 0.08);
        fieldValues
        (
            volScalarFieldValue alpha.gas 0
            volScalarFieldValue alpha.liquid 1
        );
    }
);

