FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.*"
    {
        nAlphaCorr      1;
        nAlphaSubCycles 3;
    }

    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
        maxIter         100;
    }

    p_rghFinal
    {
        $p_rgh;
        tolerance       1e-7;
        relTol          0;
    }

    "U.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.05;
        minIter         1;
        maxIter         30;
    }

    "(e|h).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.05;
        minIter         1;
        maxIter         30;
    }

    "(k|epsilon|Theta).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.05;
        minIter         1;
        maxIter         30;
    }

    "(Yi|Y.*)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.05;
        minIter         1;
        maxIter         30;
        residualAlpha   1e-8;
    }

    "(U|e|h|k|epsilon|Theta|Yi|Y.*)Final"
    {
        $U;
        tolerance       1e-6;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors        5;
    nCorrectors             2;
    nNonOrthogonalCorrectors 0;

    residualControl
    {
        p_rgh
        {
            tolerance   1e-5;
            relTol      0;
        }
        "U.*"
        {
            tolerance   1e-5;
            relTol      0;
        }
        "(e|h).*"
        {
            tolerance   1e-5;
            relTol      0;
        }
        "(Yi|Y.*)"
        {
            tolerance   1e-5;
            relTol      0;
        }
    }
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}

