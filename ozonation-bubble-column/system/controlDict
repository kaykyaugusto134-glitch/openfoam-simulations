FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     reactingTwoPhaseEulerFoam;

startFrom       latestTime; 

startTime       0;

stopAt          endTime;

endTime         200;

deltaT          0.001;

writeControl    adjustableRunTime; 

writeInterval   1;

purgeWrite      0;         

writeFormat     binary;     
writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;


adjustTimeStep  yes;

maxCo           0.8;       
maxAlphaCo      0.5;       
maxDeltaT       0.01;     
// ************************************************************************* //
